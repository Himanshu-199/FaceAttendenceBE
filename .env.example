# Copy this file to .env and adjust.

PORT=4000

# Local MongoDB:      mongodb://127.0.0.1:27017/face_attendance
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/face_attendance
MONGO_URI=mongodb://127.0.0.1:27017/face_attendance

# Frontend origin(s) allowed by CORS, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Max face distance for an attendance match (lower = stricter). 0.45 = 55% similarity.
MATCH_THRESHOLD=0.45
# Max distance between the front image and the left/right images at registration.
SAME_PERSON_THRESHOLD=0.6

# Max upload size per image, in MB.
MAX_IMAGE_MB=5
